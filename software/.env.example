# Copy to .env and set these values for your deployment. Never commit .env.
# This URL must be reachable by your displays and Home Assistant OAuth browser.
CLIENT_URL=
# Create the service administrator in the browser on first start.
# Optional: use postgresql for a hosted deployment. LiteDB remains the default.
# DATABASE_PROVIDER=postgresql
# DATABASE_CONNECTION_STRING=Host=postgres.example;Database=izboard;Username=izboard;Password=replace-me
TZ=UTC
# Optional: pin the same immutable image digest for app and renderer.
# IZBOARD_APP_IMAGE=izdevdigital/e-paper-dashboard@sha256:<digest>
